\name{sparseAdaptiveGRF-package}
\alias{sparseAdaptiveGRF}
\alias{sparseAdaptiveGRF-package}
\title{Sparse Adaptive Geographically Weighted Random Forest for Annual NPP}
\description{
Tools for fitting sparse adaptive geographically weighted random forests without
creating a dense all-pairs distance matrix. The package also provides annual NPP
training, feature selection, and raster prediction utilities.
}
\details{
Coordinates supplied to model-fitting and prediction functions must be
longitude/latitude in decimal degrees (WGS84-like geographic coordinates).
}
\seealso{\code{\link{fit_sparse_grf}}, \code{\link{run_npp_workflow}}}
\keyword{package}

